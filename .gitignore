# 凭据 / 密钥 —— 绝不入库
certs/
*.pem
*.key
*.jks
*.keystore
local.properties
.env

# 构建产物
*.apk
*.aab
build/
.gradle/
android/build/
android/.gradle/
__pycache__/
*.pyc

# 参考资料（第三方 APK，不分发）
inbox/
apk/

# 视觉稿的成品页（每次从 design/*.dc.html 重新生成，不入库）
design/yxi-app-design.html
design/_tokens.txt

# 批注页的 token 和批注数据（token 是访问凭据，不入库）
design/review/.token
design/review/pins.json

# Android 构建产物
android/build/
android/app/build/
android/.gradle/
android/local.properties
*.apk

# SwiftPM 的构建产物和依赖检出 —— 每个都是独立 git 仓库，
# `git add -A` 会把它们当嵌套仓库吞进来（而且构建中的文件会让 add 直接报错）
ios/.build/
ios/**/.build/
.swiftpm/

# sherpa-onnx 的 AAR（47MB，dev/fetch-libs.sh 下）
android/app/libs/*.aar
android/.kotlin/

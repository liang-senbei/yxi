     @TempDir lateinit var root: File
     private fun draft(store: RunnerHandoffStore) = store.draft("source-key", "local", "codex", "official:codex", "Reviewed context")
+    @Test fun `cancelled draft remains auditable and allows a fresh choice but cannot cancel started creation`() {
+        val file = File(root, "cancel.json"); val store = RunnerHandoffStore(file)
+        val initial = draft(store)
+        val cancelled = store.cancelDraft(initial.id, initial.revision)
+        assertEquals(RunnerHandoffStage.Cancelled, cancelled.stage)
+        assertNull(cancelled.targetTaskKey)
+        val reopened = RunnerHandoffStore(file)
+        assertEquals(cancelled, reopened.records.single())
+        assertFailsWith<IllegalStateException> { reopened.beginCreation(cancelled.id, cancelled.revision) }
+        val replacement = draft(reopened)
+        assertNotEquals(initial.deliveryId, replacement.deliveryId)
+        val creating = reopened.beginCreation(replacement.id, replacement.revision)
+        assertFailsWith<IllegalStateException> { reopened.cancelDraft(creating.id, creating.revision) }
+        assertEquals(2, reopened.records.size)
+    }

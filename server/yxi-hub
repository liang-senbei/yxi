#!/usr/bin/env bash
# =====================================================================
# yxi-hub —— 同一个分组里的 agent 互相说话
#
# 手机上把几个会话编进一个组，组里的 agent 就能互相发消息。
# 组存在 ~/.yxi/groups.json（手机写、这里读），一个组 = 一串 tmux 会话名。
#
#   yxi-hub who              我是谁、在哪个组、同组还有谁
#   yxi-hub context          给 Claude Code 的 SessionStart 钩子用（见下）
#   yxi-hub say <名> "话" [本次消息UUID]  发给同组成员；固定UUID用于重试去重
#   yxi-hub reply <消息ID> "话" [本次消息UUID]  回复原消息并保留关联
#   yxi-hub all <组名> "话" [批次UUID]  固定批次与成员消息ID，重试复用
#   yxi-hub reply-user <原用户消息UUID> "话" [稳定新UUID]  回信给用户（只进收件记录，不进终端）
#   yxi-hub pause|resume|status <组名>  控制该组后续消息投递
#   yxi-hub limit <组名> <消息数> <分钟>  从现在起设定新预算
#
# ⚠️ **只能发给同组的。** 这就是「组」和「所有会话」的区别 ——
#    没有这条约束，分组只是个视觉分类，不是协作边界。
# =====================================================================
set -euo pipefail

# ⚠️ **不能叫 `GROUPS`。** 那是 bash 的内置特殊变量（当前用户的组 ID 列表）——
#    赋了值也会被 bash 悄悄改回去（root 上就变成 "0"），不报错，`set -u` 也拦不住。
#    症状是「分组功能整个失灵，但每一步看着都对」。见 TROUBLESHOOTING #145。
GROUPS_FILE="${YXI_GROUPS_FILE:-${HOME}/.yxi/groups.json}"
LOG="${HOME}/.yxi/hub.log"

# 我是谁 —— 在 tmux 里就是会话名，不在就没法发（不知道署谁的名）
me() { [ -n "${TMUX:-}" ] && tmux display-message -p '#{session_name}' 2>/dev/null || true; }

# 同组的其他人（一行一个）。⚠️ 一个会话**可能在多个组里**，全都算数。
mates() {
  local self="$1"
  [ -r "$GROUPS_FILE" ] || return 0
  python3 - "$GROUPS_FILE" "$self" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
me, out = sys.argv[2], []
for members in d.get("groups", {}).values():
    if me in members:
        out += [m for m in members if m != me]
print("\n".join(dict.fromkeys(out)))
PY
}

# 按组列同组的人：每行「组名<TAB>成员1、成员2」。一个会话在几个组里就几行。
mates_by_group() {
  [ -r "$GROUPS_FILE" ] || return 0
  python3 -c 'import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
me=sys.argv[2]
for g,m in d.get("groups",{}).items():
    if me in m: print(g+"\t"+"、".join(x for x in m if x!=me))' "$GROUPS_FILE" "$1"
}

# 我和某个人**共同**在哪些组（逗号连）—— 发消息时标在前面，对方才知道这话是哪个组的事
shared_groups() {
  [ -r "$GROUPS_FILE" ] || return 0
  python3 -c 'import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
me,other=sys.argv[2],sys.argv[3]
print("/".join(g for g,m in d.get("groups",{}).items() if me in m and other in m))' "$GROUPS_FILE" "$1" "$2"
}

# 我在哪些组里
mygroups() {
  [ -r "$GROUPS_FILE" ] || return 0
  python3 -c 'import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
print("\n".join(g for g,m in d.get("groups",{}).items() if sys.argv[2] in m))' "$GROUPS_FILE" "$1"
}

# 送一句进某个 tmux 会话。
# ⚠️ **必须分两步**：文本用 `-l`（字面）送，回车单独送。
#    合成一条的话，文本里出现 "Enter" 这种字会被 send-keys 当按键名解析。
#    （Yxi 手机端 SessionProbe.send 踩过同一个坑，这里保持一致。）
#
# ⚠️⚠️ **两步之间必须隔一下，否则多行消息发不出去。**
#    Claude Code 的输入框认「括号粘贴」：一大块文本连着来，它按**粘贴**处理，
#    而粘贴块里的换行是**字面换行不是提交**。紧跟在后面的 Enter 会被算进那一块，
#    于是整段话原样躺在输入框里**没发出去** —— 用户报的就是这个（截图里
#    `[同组 cc-logto] …` 整段挂在 `❯` 后面）。
#    实测：背靠背发 3 行 → 留在框里；中间 `sleep 0.4` → 正常提交。
#    ⚠️ 单行消息不会触发（不够长，不当粘贴），所以这个坑只有 agent 之间
#    发长消息时才露头 —— 手测「你好」是测不出来的。
record_event() {
  python3 - "$HOME/.yxi/hub-events.jsonl" "$@" "${sender_instance:-}" "${recipient_instance:-}" "$GROUPS_FILE" "${raw_content:-}" "${user_group:-}" <<'PY'
import datetime, fcntl, hashlib, json, os, pathlib, sys, uuid, time
path, message, sender, recipient, stage, body, reply, sender_instance, recipient_instance, groups_path, raw_content, user_group = sys.argv[1:]
if str(uuid.UUID(message)) != message: raise ValueError('消息 ID 必须是标准小写 UUID')
p = pathlib.Path(path)
p.parent.mkdir(parents=True, exist_ok=True)
event = {'version': 1, 'id': message, 'sender': sender, 'recipient': recipient,
         'senderInstance': sender_instance, 'recipientInstance': recipient_instance,
         'stage': stage, 'text': body, 'replyTo': reply, 'time': datetime.datetime.now(datetime.timezone.utc).isoformat()}
event['createdAt'] = time.time()
event['senderKind'] = 'user' if user_group else 'agent'
if stage == 'attempting': event['contentHash'] = hashlib.sha256(raw_content.strip().encode()).hexdigest()
fd = os.open(p, os.O_RDWR | os.O_CREAT | os.O_APPEND, 0o600)
with os.fdopen(fd, 'a+', encoding='utf-8') as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    if stage == 'attempting':
        f.seek(0)
        previous, events = [], []
        for line in f:
            if not line.strip(): continue
            try: stored = json.loads(line)
            except ValueError: raise ValueError('事件记录损坏，无法确认去重状态；请先核对日志')
            events.append(stored)
            if stored.get('id') == message: previous.append(stored)
        if previous:
            first = next((e for e in previous if e.get('stage') == 'attempting'), None)
            if first is None or any(first.get(k, '') != event[k] for k in ['sender', 'recipient', 'text', 'replyTo', 'senderInstance', 'recipientInstance']):
                raise ValueError('同一消息 ID 对应不同内容或缺少原始记录，拒绝重发')
            if previous[-1].get('stage') == 'terminal-written':
                print('duplicate-terminal')
                sys.exit(0)
            raise ValueError('该消息已登记但投递未确认，拒绝自动重发；请查看目标终端')
        if reply:
            starts = {e['id']: e for e in events if e.get('stage') == 'attempting'}
            cursor, seen, repeated = reply, set(), 0
            while cursor:
                if cursor in seen: raise ValueError('回复记录存在循环，已阻止新投递')
                seen.add(cursor)
                if len(seen) >= 16: raise ValueError('回复链达到 16 条上限，请先汇总并由用户决定后续工作')
                parent = starts.get(cursor)
                if parent is None: raise ValueError('回复链记录不完整，请人工核对后再继续')
                if parent.get('contentHash') == event['contentHash']: repeated += 1
                if repeated >= 2: raise ValueError('同一回复链内容重复，已阻止第三次相同内容，请先检查协作记录')
                cursor = parent.get('replyTo', '')
        with open(groups_path) as source: groups = json.load(source)['groups']
        shared = [g for g, members in groups.items() if recipient in members and (g == user_group if user_group else sender in members)]
        if not shared: raise ValueError('双方已不在同组，拒绝投递')
        control_file = p.parent / 'hub-control.json'
        control = json.loads(control_file.read_text()) if control_file.exists() else {}
        for group in shared:
            settings = control.get(group, {})
            if settings.get('paused'): raise ValueError('协作组已暂停：' + group)
            if settings.get('deadline', 0) and time.time() >= settings['deadline']:
                raise ValueError('协作时间预算已到期：' + group)
            limit = settings.get('messageLimit', 0)
            if limit:
                used = len({e['id'] for e in events if e.get('stage') == 'attempting' and group in e.get('groups', []) and e.get('createdAt', 0) >= settings.get('budgetStartedAt', 0)})
                if used >= limit: raise ValueError('协作消息预算已用完：' + group)
        event['groups'] = shared
    f.write(json.dumps(event, ensure_ascii=False) + '\n')
    f.flush(); os.fsync(f.fileno())
    if stage == 'attempting': print('new')
PY
}

# Agent 回信给用户。用户没有 tmux 会话，所以这**不是**一次投递：
# 只往 hub-events 里追加两条记录，桌面收信 UI 自己来读。
#   yxi-hub reply-user <原用户消息UUID> "话" [稳定新UUID]
#
# ⚠️ 身份核对（缺一不可，都在事件日志锁内做）：
#    1. 调用者必须在真实 tmux 会话里（self 非空），且它的任务实例
#       要等于**原用户消息**的 recipientInstance —— 同名重建过的会话
#       不再是原收件人，回信作废。
#    2. 原消息必须 senderKind=user（用户发的话）。回信回 agent 的话
#       请走 reply，别把 agent 互发的内容伪装成回信塞给用户。
#
# ⚠️ **只追加两条记录，不碰任何 tmux 目标、不发按键。**
#    先 attempting（保留正文、带 contentHash），紧接着 user-inbox
#    （= 回信记录已保存）。user-inbox 只表示记录落盘，**不代表用户已读**。
#    两条都写在这**一次** flock 里，但各写一行、各自 fsync（沿用现有
#    durability）—— 进程死在两行之间会留下只有 attempting 的回信，
#    这时同 ID 重试一律拒绝（未知不重放），由人工核对收件后再定。
#
# ⚠️ 组成员 / 暂停 / 时间与消息预算 / 回复链 / 同 ID 内容去重
#    全部沿用旧路径的那套判断（ recipient=用户 不在组名单里，
#    所以组成员按「调用者仍在原消息的组里」判）。
reply_event() {
  python3 - "$HOME/.yxi/hub-events.jsonl" "$HOME/.yxi/hub-control.json" "$GROUPS_FILE" "$@" <<'PY'
import datetime, fcntl, hashlib, json, os, pathlib, sys, uuid, time
path, control_path, groups_path, original_id, body, message, sender, sender_instance = sys.argv[1:]
if str(uuid.UUID(message)) != message: raise ValueError('回信 ID 必须是标准小写 UUID')
if str(uuid.UUID(original_id)) != original_id: raise ValueError('原消息 ID 必须是标准小写 UUID')
p = pathlib.Path(path)
p.parent.mkdir(parents=True, exist_ok=True)
content_hash = hashlib.sha256(body.strip().encode()).hexdigest()
fd = os.open(p, os.O_RDWR | os.O_CREAT | os.O_APPEND, 0o600)
with os.fdopen(fd, 'a+', encoding='utf-8') as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    f.seek(0)
    previous, events, original = [], [], None
    for line in f:
        if not line.strip(): continue
        try: stored = json.loads(line)
        except ValueError: raise ValueError('事件记录损坏，无法确认去重状态；请先核对日志')
        events.append(stored)
        if stored.get('id') == message: previous.append(stored)
        if stored.get('id') == original_id and stored.get('stage') == 'attempting' and original is None:
            original = stored
    if original is None or original.get('senderKind') != 'user':
        raise ValueError('原消息不是用户消息，不能回信')
    if original.get('recipientInstance') != sender_instance:
        raise ValueError('你已不是原消息的接收任务实例，拒绝回信；如需继续请用 say 另行说明')
    def reply_text(group):
        return '[回信 · %s · %s] %s' % (group, sender, body)
    if previous:
        first = next((e for e in previous if e.get('stage') == 'attempting'), None)
        if first is None: raise ValueError('同一回信 ID 对应不同内容或缺少原始记录，拒绝重发')
        same = first.get('text') == reply_text((original.get('groups') or [''])[0]) \
            and first.get('replyTo') == original_id and first.get('sender') == sender \
            and first.get('senderInstance') == sender_instance and first.get('recipient') == '用户' \
            and first.get('recipientInstance') == original.get('senderInstance')
        if not same: raise ValueError('同一回信 ID 对应不同内容或缺少原始记录，拒绝重发')
        if previous[-1].get('stage') == 'user-inbox':
            print('duplicate-inbox')
            sys.exit(0)
        raise ValueError('该回信已登记但收件记录未确认，拒绝自动重放；请先人工核对收件记录')
    group = (original.get('groups') or [''])[0]
    # 回复链沿用旧 reply 那套：循环检测、16 条上限、链内同文重复
    starts = {e['id']: e for e in events if e.get('stage') == 'attempting'}
    cursor, seen, repeated = original_id, set(), 0
    while cursor:
        if cursor in seen: raise ValueError('回复记录存在循环，已阻止新投递')
        seen.add(cursor)
        if len(seen) >= 16: raise ValueError('回复链达到 16 条上限，请先汇总并由用户决定后续工作')
        parent = starts.get(cursor)
        if parent is None: raise ValueError('回复链记录不完整，请人工核对后再继续')
        if parent.get('contentHash') == content_hash: repeated += 1
        if repeated >= 2: raise ValueError('同一回复链内容重复，已阻止第三次相同内容，请先检查协作记录')
        cursor = parent.get('replyTo', '')
    with open(groups_path) as source: groups = json.load(source)['groups']
    if group not in groups or sender not in groups[group]:
        raise ValueError('你已不在原协作组，拒绝回信：' + group)
    control = json.loads(pathlib.Path(control_path).read_text()) if pathlib.Path(control_path).exists() else {}
    settings = control.get(group, {})
    if settings.get('paused'): raise ValueError('协作组已暂停：' + group)
    if settings.get('deadline', 0) and time.time() >= settings['deadline']:
        raise ValueError('协作时间预算已到期：' + group)
    limit = settings.get('messageLimit', 0)
    if limit:
        used = len({e['id'] for e in events if e.get('stage') == 'attempting' and group in e.get('groups', []) and e.get('createdAt', 0) >= settings.get('budgetStartedAt', 0)})
        if used >= limit: raise ValueError('协作消息预算已用完：' + group)
    def event(stage):
        item = {'version': 1, 'id': message, 'sender': sender, 'recipient': '用户',
                'senderInstance': sender_instance, 'recipientInstance': original.get('senderInstance'),
                'stage': stage, 'text': reply_text(group), 'replyTo': original_id,
                'time': datetime.datetime.now(datetime.timezone.utc).isoformat()}
        item['createdAt'] = time.time()
        item['senderKind'] = 'agent'
        item['recipientKind'] = 'user'
        item['groups'] = [group]
        if stage == 'attempting': item['contentHash'] = content_hash
        return item
    f.write(json.dumps(event('attempting'), ensure_ascii=False) + '\n')
    f.flush(); os.fsync(f.fileno())
    f.write(json.dumps(event('user-inbox'), ensure_ascii=False) + '\n')
    f.flush(); os.fsync(f.fileno())
    print('new')
PY
}

check_group_delivery() {
  python3 - "$GROUPS_FILE" "$HOME/.yxi/hub-control.json" "$1" "$2" "${user_group:-}" <<'PY'
import json, pathlib, sys
groups_path, control_path, sender, recipient, user_group = sys.argv[1:]
with open(groups_path) as f: groups = json.load(f)['groups']
shared = [name for name, members in groups.items() if recipient in members and (name == user_group if user_group else sender in members)]
if not shared: raise ValueError('双方已不在同一协作组，拒绝投递')
p = pathlib.Path(control_path)
control = json.loads(p.read_text()) if p.exists() else {}
paused = [name for name in shared if control.get(name, {}).get('paused', False)]
if paused: raise ValueError('协作组已暂停新消息投递：' + '、'.join(paused))
PY
}

push() {
  local target="$1" text="$2" sender="${3:-?}" reply="${4:-}" message="${5:-}" raw_content="${6:-$2}" reservation
  check_group_delivery "$sender" "$target" || return 1
  local sender_instance recipient_instance pane target_info
  if [ -n "${user_group:-}" ]; then sender_instance="user:$(id -u)"
  else sender_instance="$(tmux display-message -p -t "=$sender:" '#{pid}:#{session_id}:#{session_created}')" || return 1; fi
  target_info="$(tmux display-message -p -t "=$target:" '#{pid}:#{session_id}:#{session_created} #{pane_id}')" || return 1
  read -r recipient_instance pane <<< "$target_info"
  [ -z "${expected_recipient:-}" ] || [ "$recipient_instance" = "$expected_recipient" ] || { echo "目标任务实例已变化" >&2; return 1; }
  [ -n "$sender_instance" ] && [ -n "$recipient_instance" ] && [ -n "$pane" ] || return 1
  if [ -z "$message" ]; then message="$(python3 -c 'import uuid; print(uuid.uuid4())')"; fi
  reservation="$(record_event "$message" "$sender" "$target" attempting "$text" "$reply")" || return 1
  if [ "$reservation" = duplicate-terminal ]; then
    echo "消息 $message 之前已写入终端，本次未重复投递（不代表 Agent 已处理）"
    return 0
  fi
  if [ "$(tmux display-message -p -t "$pane" '#{pid}:#{session_id}:#{session_created}' 2>/dev/null)" != "$recipient_instance" ]; then
    record_event "$message" "$sender" "$target" write-unknown "" "$reply" || true
    echo "目标任务实例已变化，未继续写入" >&2
    return 1
  fi
  local delivery_text="$text"
  if [ -n "${user_group:-}" ]; then
    delivery_text+=$'\n\n'
    delivery_text+="回复用户请使用：yxi-hub reply-user $message \"回复内容\" [稳定新UUID]。回信会进入桌面协作收件记录；需要重试时复用同一新UUID。"
  fi
  if ! tmux send-keys -t "$pane" -l "[协作消息 $message] $delivery_text"; then
    record_event "$message" "$sender" "$target" write-unknown "" "$reply" || true
    return 1
  fi
  sleep 0.4
  if [ "$(tmux display-message -p -t "$pane" '#{pid}:#{session_id}:#{session_created}' 2>/dev/null)" != "$recipient_instance" ] || ! tmux send-keys -t "$pane" Enter; then
    record_event "$message" "$sender" "$target" submit-unknown "" "$reply" || true
    return 1
  fi
  record_event "$message" "$sender" "$target" terminal-written "" "$reply" || {
    echo "消息 $message 已写入终端，但完成记录保存失败；请核对，不要自动重发" >&2
    return 1
  }
  printf '%s\t%s -> %s\t%s\n' "$(date -Iseconds)" "${3:-?}" "$target" "$text" >> "$LOG"
}

user_group=""
expected_recipient=""
self="$(me)"

case "${1:-who}" in
  user-say|user-reply)
    if [ "$1" = user-reply ]; then [ "$#" -eq 7 ] || exit 1
    else [ "$#" -eq 6 ] || { echo '用法: yxi-hub user-say <组名> <完整任务名> <任务实例ID> <消息> <消息UUID>'; exit 1; }; fi
    user_group="$2"; expected_recipient="$4"
    [ -n "$user_group" ] && [ -n "$3" ] && [ -n "$expected_recipient" ] && [ -n "$5" ] || exit 1
    user_reply=""
    if [ "$1" = user-reply ]; then
      user_reply="$7"
      python3 - "$HOME/.yxi/hub-events.jsonl" "$7" "$2" "$3" "$4" <<'PY'
import json, sys, uuid
path, reply, group, target, instance = sys.argv[1:]
uuid.UUID(reply)
found = False
with open(path, encoding='utf-8') as stream:
    for line in stream:
        event = json.loads(line)
        if event.get('id') == reply and event.get('stage') == 'attempting':
            found = event.get('sender') == target and event.get('senderInstance') == instance and event.get('senderKind', 'agent') == 'agent' and group in event.get('groups', [])
            break
if not found: raise ValueError('原消息或原发送任务实例不匹配，拒绝回复')
PY
    fi
    push "$3" "[用户消息 · $user_group${user_reply:+ · 回复 $user_reply}] $5" "用户" "$user_reply" "$6" "$5"
    echo "用户消息已写入目标终端，尚无处理回执"
    printf '__YXI_USER_MESSAGE__:%s\n' "$6"
    ;;
  reply-user)
    [ -n "$self" ] || { echo "不在 tmux 里，认不出是谁在回信"; exit 1; }
    [ "$#" -ge 3 ] && [ "$#" -le 4 ] || { echo '用法: yxi-hub reply-user <原用户消息UUID> <正文> [稳定新UUID]'; exit 1; }
    original_id="$2"; body="$3"; message="${4:-}"
    [ -n "$body" ] || exit 1
    [ -n "$message" ] || message="$(python3 -c 'import uuid; print(uuid.uuid4())')"
    # 调用者自己的**真实**任务实例（=名字 精确匹配），回信资格靠它对上原消息的收件实例
    sender_instance="$(tmux display-message -p -t "=$self:" '#{pid}:#{session_id}:#{session_created}')" || exit 1
    [ -n "$sender_instance" ] || exit 1
    outcome="$(reply_event "$original_id" "$body" "$message" "$self" "$sender_instance")" || exit 1
    if [ "$outcome" = duplicate-inbox ]; then
      echo "回信 $message 之前已保存到用户收件，本次未重复记录（不代表用户已读）"
    else

PY
)"
      text="[回复 $reply_to] $text"
    fi
    # 名字可以只写片段，同组内唯一匹配即可
    if [ -n "$reply_to" ]; then
      hit="$(mates "$self" | grep -xF -- "$target" || true)"
    else
      hit="$(mates "$self" | grep -ixF -- "$target" || mates "$self" | grep -iF -- "$target" || true)"
    fi

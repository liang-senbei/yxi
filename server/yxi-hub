    echo "群发批次：$batch（重试请复用此 ID）"
    while IFS=$'\t' read -r one message_id; do
      [ -n "$one" ] && push "$one" "[同组 $grp · $self] $text" "$self" "" "$message_id"
    done <<< "$recipients"
    echo "「$grp」组终端投递完成或已有完成记录；尚无成员处理回执"
    ;;
  *) sed -n '3,13p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac

ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG INSTALL_GUI=0
RUN if [ "$INSTALL_GUI" = 1 ]; then apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openjdk-21-jre fonts-noto-cjk libgl1 && \
    rm -rf /var/lib/apt/lists/*; fi
# The base image owns this directory; no host directory is mounted during build.
RUN rm -rf /workspace && mkdir /workspace
COPY . /workspace
WORKDIR /workspace
RUN cd android && bash gradlew -Pyxi.desktopOnly=true :core:testClasses :desktop:testClasses :desktop:cacheIsolatedRuntime \
    -I /workspace/dev/isolated-tests/cache.init.gradle --offline --no-daemon --max-workers=1 \
    -Dorg.gradle.jvmargs=-Xmx1536m -Pkotlin.compiler.execution.strategy=in-process
ARG SOURCE_REVISION
LABEL org.yxi.test-isolation="1" org.yxi.source-revision=$SOURCE_REVISION

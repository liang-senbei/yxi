<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 手机主动响：常驻一条 SSH 通道 tail 事件流。
         ⚠️ **不用 FCM** —— 用户的荣耀 Magic7 默认关着 GMS（PRD §2.5 / D8），
         走推送等于把一个能用的功能建在一个默认不可用的基础上。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自起：手机重启后不用手动打开 App 才恢复盯梢 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 自更新：从自己的服务器上取新包并拉起系统安装器。
         ⚠️ 只是「拉起安装器」，装不装还是系统和用户说了算 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yxi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Yxi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 把下载到私有目录的 APK 交给系统安装器 —— 不经过任何共享存储 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.yxi.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".watch.EventService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 通知按钮上选一项 → 送键。⚠️ 必须是广播：通知动作用 getService 会被静默挡掉 -->
        <receiver
            android:name=".watch.AnswerReceiver"
            android:exported="false" />

        <receiver
            android:name=".watch.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

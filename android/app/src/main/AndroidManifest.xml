<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 开发者模式的诊断要分清「WiFi 还是移动网络」——
         运营商屏蔽端口只发生在移动网络上，「WiFi 能连、插卡不能连」本身就是答案 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 手机主动响：常驻一条 SSH 通道 tail 事件流。
         ⚠️ **不用 FCM** —— 用户的荣耀 Magic7 默认关着 GMS（PRD §2.5 / D8），
         走推送等于把一个能用的功能建在一个默认不可用的基础上。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 锁屏上把屏幕点亮、直接把「要你批什么」摆出来。
         ⚠️ Android 14 起系统**默认不给**非通话/闹钟类应用这个权限 ——
         所以代码里必须能优雅降级（拿不到就退回普通高优先级通知），
         见 EventService.postNeeds 里的 canFullScreen()。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 开机自起：手机重启后不用手动打开 App 才恢复盯梢 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 直接对本应用弹「后台不受限制」的授权框。
         ⚠️ 没有这条权限，那个 intent 会被拒，只能退回到「已放行应用列表」——
         而我们还没被放行，用户在那个列表里根本找不到这个 App。见 TROUBLESHOOTING #74 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 自更新：从自己的服务器上取新包并拉起系统安装器。
         ⚠️ 只是「拉起安装器」，装不装还是系统和用户说了算 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 按住说话。⚠️ 识别跑在**用户自己的服务器**上（server/yxi-asr），
         录音只是上传的原料，App 不往任何云服务发音频。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ⚠️ `allowBackup="false"`（2026-09-04 安全审计）：这个 App 的数据本来换机就带不走 ——
         Keystore 密钥不进备份，SSH 私钥和主机密码到了新机解不开；
         而备份能带走的恰恰是 hosts.json（主机清单：地址/端口/用户名）和登录令牌。 -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yxi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Yxi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Logto 登录跳回来（PKCE 的 redirect_uri）。
                 ⚠️ MainActivity 是 singleTask，所以回调走 onNewIntent，不会再开一个界面。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.yxi.app" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- 分享到某个会话：从别的 app 分享文字/图片/文件进来 -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Yxi">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <!-- 相册里一次分享多张：SEND_MULTIPLE，EXTRA_STREAM 是列表 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- 把下载到私有目录的 APK 交给系统安装器 —— 不经过任何共享存储 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.yxi.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".watch.EventService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 通知按钮上选一项 → 送键。⚠️ 必须是广播：通知动作用 getService 会被静默挡掉 -->
        <receiver
            android:name=".watch.AnswerReceiver"
            android:exported="false" />

        <receiver
            android:name=".watch.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 快捷设置磁贴：Claude · N 个等你 -->
        <service
            android:name=".widget.WaitingTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_yxi"
            android:label="Claude"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 桌面小组件：会话状态一眼看 -->
        <receiver
            android:name=".widget.WaitingWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_waiting_info" />
        </receiver>
    </application>
</manifest>

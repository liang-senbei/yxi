<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 手机主动响：常驻一条 SSH 通道 tail 事件流。
         ⚠️ **不用 FCM** —— 用户的荣耀 Magic7 默认关着 GMS（PRD §2.5 / D8），
         走推送等于把一个能用的功能建在一个默认不可用的基础上。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自起：手机重启后不用手动打开 App 才恢复盯梢 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yxi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Yxi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".watch.EventService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 通知按钮上选一项 → 送键。⚠️ 必须是广播：通知动作用 getService 会被静默挡掉 -->
        <receiver
            android:name=".watch.AnswerReceiver"
            android:exported="false" />

        <receiver
            android:name=".watch.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
